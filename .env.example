# ============================================================================
# Variáveis de ambiente: SOMENTE NOMES E VALORES FICTÍCIOS (SEG-02, DEV-07).
# Valores reais: Vercel -> Settings -> Environment Variables, um conjunto por
# ambiente (SEG-04). Localmente, copie para .env.local (ignorado pelo git).
#
# [PÚBLICA]  vai para o navegador; só valor que qualquer visitante pode ler.
# [PRIVADA]  nunca neste projeto: o app é só front (SPA) e tudo com prefixo
#            VITE_ vai para o navegador (SEG-03). Segredo fica no Supabase.
# Todas são validadas em src/lib/env.ts; faltando alguma, o build falha (SEG-01).
# ============================================================================

# [PÚBLICA] URL do projeto Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://exemplo.supabase.co
# [PÚBLICA] Chave publishable (ou anon) do Supabase; o acesso real é controlado pelo RLS.
# NUNCA coloque aqui a service role / secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ficticia_para_exemplo
